# dsh-plugin-guard — environment template
#
# Copy to `.env` only if you want to override something; every variable below is
# OPTIONAL and none of them is a secret. This plugin stores no API keys, tokens
# or passwords anywhere, so there is nothing to fill in here: the values are
# placeholders showing the expected shape.
#
# The plugin itself reads these through `process.env`, and DSH's settings panel
# (Settings -> Plugins -> Plugin Guard) is the recommended place to manage the
# behaviour it exposes. Variables are for CLI use, CI, or multiple profiles.

# Where DSH keeps its profiles (default: %USERPROFILE%\.dsh on Windows, ~/.dsh elsewhere)
DSH_HOME=/path/to/your/.dsh

# Which profile the CLI targets when --profile is not given (e.g. web, tui, sdk)
DSH_PROFILE=YOUR_PROFILE_NAME

# Where the guard keeps its own data (history.json, backups/, watchdog.log).
# Default: <DSH_HOME>/plugin-guard
DSH_PLUGIN_GUARD_HOME=/path/to/your/plugin-guard-data

# Explicit path to the `dsh` CLI entry when it is not on PATH.
# Default: auto-detected from the global npm prefix / DSH installation tree
DSH_PLUGIN_GUARD_DSH=/path/to/dsh/lib/bin.js

# npm registry used by the precheck when reading package metadata.
# Default: https://registry.npmjs.org
DSH_PLUGIN_GUARD_REGISTRY=https://registry.npmjs.org

# Test seam for the crash watchdog dialog: yes | no | cancel.
# When set, no native dialog is shown and the value is used instead.
# Leave unset (or empty) for normal interactive use.
DSH_PLUGIN_GUARD_WATCHDOG_ANSWER=YOUR_TEST_ANSWER

# DSH desktop build only: the profile it opens by default.
DSH_DESKTOP_DEFAULT_PROFILE=YOUR_PROFILE_NAME
